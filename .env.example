# NutriTrack AI Environment Variables

# App Details
NEXT_PUBLIC_APP_NAME="NutriTrack AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NutriTrack Python Scanner Service (Server-only; NEVER prefix with NEXT_PUBLIC_)
# Local development default: http://127.0.0.1:8001
SCANNER_URL=http://127.0.0.1:8001
# Optional shared secret key (matches SCANNER_API_KEY in nutritrack-scanner)
SCANNER_API_KEY=

# Optional AI Assistant / LLM Integration
GROQ_API_KEY=

# Optional Supabase Database Persistence
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
